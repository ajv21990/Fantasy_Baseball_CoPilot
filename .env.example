# ESPN Fantasy Baseball Credentials
# Get these from your browser after logging into fantasy.espn.com:
#   DevTools (F12) → Application → Storage → Cookies → https://www.espn.com
#   Copy the full value of "espn_s2" and "SWID"

ESPN_S2=your_espn_s2_cookie_value_here
SWID={your-swid-value-in-braces-here}

# Your team name as it appears in the ESPN league (partial match is fine)
MY_TEAM_NAME=YourTeamNameHere

# Admin email shown on the "Session Expired" page (cookie refresh notification)
ADMIN_EMAIL=your_admin_email@example.com
