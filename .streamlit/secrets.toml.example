# Streamlit secrets for the Player Rater feature.
#
# Copy this file to `.streamlit/secrets.toml` (which is git-ignored) and fill in
# your real values. On Streamlit Community Cloud, paste the same contents into the
# app's Secrets manager instead of committing a file.
#
# If [connections.supabase] is omitted, the Player Rater automatically falls back
# to a local SQLite file at data/player_rater.db — handy for local development,
# but NOT shared across users and NOT persistent on Streamlit Cloud.

[connections.supabase]
# Supabase → Project Settings → Database → Connection string (URI).
# Use the connection-pooler URL. Format:
url = "postgresql://postgres:<password>@<host>:5432/postgres"
